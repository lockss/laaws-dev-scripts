# List of services to run.  Each line is <name>=<service-jar>, where <name>
# is one of cfg, repo, poller, md, crawler and <service-jar> is either a path
# to the corresponding uber jar (absolute or relative to the
# laaws-dev-scripts/runcluster directory), or mvn:<artifact>, where
# <artifact> is groupId:artifactId:version .  In the latter case mvn will
# be invoked to obtain the jar.

repo=mvn:org.lockss.laaws:laaws-repository-service:2.16.0
cfg=mvn:org.lockss.laaws:laaws-configuration-service:2.10.0
poller=mvn:org.lockss.laaws:laaws-poller:2.8.0
crawler=mvn:org.lockss.laaws:laaws-crawler-service:1.2.0
md=mvn:org.lockss.laaws:laaws-metadata-service:2.8.0
#soap=mvn:org.lockss.laaws:laaws-soap-service:1.6.0
pgsql=postgres:14
#pgsql=arm64v8/postgres:14
